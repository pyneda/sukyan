<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Title }} - Sukyan Scanner Report</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
    <style>{{ styles }}</style>
    {{ if .Highlight }}<style>{{ syntaxStyles }}</style>{{ end }}
</head>
<body>
    <header class="header">
        <div class="container header-inner">
            <div class="header-title">
                <svg class="logo" viewBox="8.5 4.5 15 20" aria-hidden="true">
                    <path d="M20.8 11.5c0-2.6-2-4.2-4.8-4.2s-4.8 1.6-4.8 4.2c0 5.2 9.6 2.8 9.6 7.4 0 2-1.8 3-4.8 3s-4.8-1.6-4.8-3.4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ .Title }}</span>
            </div>
            <button type="button" id="theme-toggle" class="theme-toggle no-print" aria-label="Toggle theme">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="m19.07 4.93-1.41 1.41"/><path d="M22 12h-2"/><path d="m19.07 19.07-1.41-1.41"/><path d="M12 20v2"/><path d="m4.93 19.07 1.41-1.41"/><path d="M2 12h2"/><path d="m4.93 4.93 1.41 1.41"/>
                </svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
            </button>
        </div>
    </header>

    <main class="container" style="padding-top:1.25rem;padding-bottom:3rem">
        <section class="stat-grid" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0.75rem;margin-bottom:0.75rem">
            <div class="card stat">
                <p class="stat-label">Total Issues</p>
                <p class="stat-value">{{ .Summary.TotalIssues }}</p>
                <p class="stat-hint">across {{ .Summary.UniqueIssueTypes }} categories</p>
            </div>
            <div class="card stat">
                <p class="stat-label">Critical &amp; High</p>
                <p class="stat-value" style="color:var(--severity-critical-fg)">{{ add .Summary.CriticalCount .Summary.HighCount }}</p>
                <p class="stat-hint">{{ .Summary.CriticalCount }} critical, {{ .Summary.HighCount }} high</p>
            </div>
            <div class="card stat">
                <p class="stat-label">Issue Types</p>
                <p class="stat-value">{{ .Summary.UniqueIssueTypes }}</p>
                <p class="stat-hint">distinct findings</p>
            </div>
            <div class="card stat">
                <p class="stat-label">Affected Endpoints</p>
                <p class="stat-value">{{ .Summary.UniqueAffectedEndpoints }}</p>
                <p class="stat-hint">unique hosts</p>
            </div>
        </section>

        <section class="chart-grid" style="display:grid;grid-template-columns:minmax(0,22rem) minmax(0,1fr);gap:0.75rem;margin-bottom:1.25rem">
            <div class="card">
                <div class="card-head">Issues by Severity</div>
                <div class="card-body">
                    {{ .SeverityDonut }}
                    <div class="legend">
                        <span class="legend-item"><span class="legend-swatch" style="background:var(--severity-critical)"></span>Critical {{ .Summary.CriticalCount }}</span>
                        <span class="legend-item"><span class="legend-swatch" style="background:var(--severity-high)"></span>High {{ .Summary.HighCount }}</span>
                        <span class="legend-item"><span class="legend-swatch" style="background:var(--severity-medium)"></span>Medium {{ .Summary.MediumCount }}</span>
                        <span class="legend-item"><span class="legend-swatch" style="background:var(--severity-low)"></span>Low {{ .Summary.LowCount }}</span>
                        <span class="legend-item"><span class="legend-swatch" style="background:var(--severity-info)"></span>Info {{ .Summary.InfoCount }}</span>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-head">Top Issue Types</div>
                <div class="card-body">
                    {{ range .TopTypes }}
                    <div class="bar">
                        <span class="bar-label" title="{{ .Title }}">{{ .Title }}</span>
                        <span class="bar-track"><span class="bar-fill" style="width:{{ printf "%.1f" .Percent }}%"></span></span>
                        <span class="bar-count">{{ .Count }}</span>
                    </div>
                    {{ else }}
                    <p class="empty">No issues to chart</p>
                    {{ end }}
                </div>
            </div>
        </section>

        <div class="layout">
            <aside class="card sidebar no-print">
                <div class="card-head" style="display:block">
                    <input type="search" id="search-input" class="input" placeholder="Search issues..." aria-label="Search issues">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-top:0.5rem">
                        <span id="result-count" class="stat-hint">{{ .Summary.TotalIssues }} issues</span>
                        <select id="severity-filter" class="select" aria-label="Filter by severity">
                            <option value="all">All severities</option>
                            <option value="Critical">Critical</option>
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                            <option value="Info">Info</option>
                        </select>
                    </div>
                </div>
                <div id="issues-container" class="sidebar-list"></div>
            </aside>

            <section id="issue-details" class="card">
                <div class="empty">No findings in this report</div>
            </section>
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>Generated {{ .GeneratedAt }}</span>
            <span>{{ .Summary.TotalIssues }} findings &middot; Sukyan</span>
        </div>
    </footer>

    <div id="toast" class="card no-print" role="status" aria-live="polite" style="position:fixed;bottom:1rem;right:1rem;padding:0.5rem 0.875rem;font-size:0.8125rem;opacity:0;transform:translateY(0.5rem);transition:opacity 0.2s ease,transform 0.2s ease;pointer-events:none;z-index:50"></div>

    <script>window.__SUKYAN_REPORT__ = {{ .Payload }};</script>
    {{ if .Highlight }}<script>{{ syntaxScript }}</script>{{ end }}
    <script>{{ script }}</script>
</body>
</html>
